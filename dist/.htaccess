# ==============================================================================
# Apache 2.4 Production Configuration (cPanel / MariaDB 10.11 / Afrihost)
# Optimized for Lycos Core Headless React SPA + PHP Microservices
# ==============================================================================

# 1. Server Security & Directory Browsing Prevention
DirectoryIndex index.html index.php default.html
Options -Indexes +FollowSymLinks
AddDefaultCharset UTF-8

# Block access to sensitive hidden and environment files
<FilesMatch "^\.|\.(env|log|sql|json|lock|md|yml|yaml|sample)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Allow public access to manifest or public json if needed
<FilesMatch "^(manifest\.json|package\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# 2. HTTP Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# 3. Explicit MIME Types
<IfModule mod_mime.c>
    AddType application/javascript .js .mjs
    AddType text/css .css
    AddType image/svg+xml .svg .svgz
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType font/ttf .ttf
    AddType application/json .json
    AddType image/x-icon .ico
</IfModule>

# 4. Gzip / Deflate Compression (mod_deflate)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE font/ttf
</IfModule>

# 5. Browser Caching Rules (mod_expires)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # HTML and dynamic data - always validate with server
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
    
    # Static Assets with content hashes (1 year cache)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# 6. URL Rewriting & SPA Routing (mod_rewrite)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # A. If the requested file or directory exists physically, serve directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # B. API & Microservice Routing
    RewriteRule ^api/cipher/?$ cipher.php [L,QSA]
    RewriteRule ^cipher\.php$ - [L]

    # C. Single Page Application (SPA) - Route all virtual routes to index.html
    RewriteRule ^ index.html [L,QSA]
</IfModule>
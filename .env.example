# ==============================================================================
# Lycos Core Production Environment Configuration (cPanel / MariaDB 10.11)
# ==============================================================================

# AI & LLM Integrations
GEMINI_API_KEY=your_production_gemini_api_key_here

# MariaDB 10.11 / MySQL Database Connection (if using dynamic CMS / custom tables)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=yourcpanel_lycos_db
DB_USER=yourcpanel_lycos_user
DB_PASSWORD=your_secure_mariadb_password
DB_CHARSET=utf8mb4
DB_COLLATE=utf8mb4_unicode_ci

# Site Configuration
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.co.za